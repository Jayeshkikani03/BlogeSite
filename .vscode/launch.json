{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Backend (Dev)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "Start Backend Server",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start Frontend Server"
    }
  ],
  "compounds": [
    {
      "name": "Launch Entire App",
      "configurations": ["Launch Backend (Dev)", "Launch Frontend (Chrome)"]
    }
  ]
}
